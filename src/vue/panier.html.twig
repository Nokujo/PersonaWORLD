{% block styles %}
  <style>
    body {
      background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.7)), 
                  url('img/panier.jpg') no-repeat center center fixed;
      background-size: cover;
      background-attachment: fixed;
    }
  </style>
{% endblock %}
{% extends "base.html.twig" %}
{% block title %} {{ parent() }}Mon Panier{% endblock %}
{% block contenu %}
<div class="container mt-5">
  <h2>Mon Panier</h2>

  {% if form.valide is defined %}
    {% if form.valide %}
      <div class="alert alert-success">{{ form.message }}</div>
      {% if form.erreur is defined %}
        <div class="alert alert-warning">{{ form.erreur }}</div>
      {% endif %}
    {% else %}
      <div class="alert alert-danger">{{ form.message }}</div>
    {% endif %}
  {% endif %}

  {% if liste|length > 0 %}
    <form action="index.php?page=panier" method="post">
      <table class="table">
        <thead>
          <tr>
            <th>Produit</th><th>Action</th><th>Prix</th><th>Qté</th><th>Total</th>
          </tr>
        </thead>
        <tbody>
          {% set total = 0 %}
          {% for p in liste %}
            {% set somme = session.panier[p.id] * p.prix %}
            {% set total = total + somme %}
            <tr>
              <td><a href="index.php?page=produitfiche&id={{ p.id }}">{{ p.nom }}</a></td>
              <td><a href="index.php?page=panier&remove={{ p.id }}" class="text-danger">Supprimer</a></td>
              <td>{{ p.prix }} €</td>
              <td><input type="number" name="q-{{ p.id }}" value="{{ session.panier[p.id] }}" min="1" required></td>
              <td>{{ somme }} €</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <div class="text-right mb-3"><strong>Total : {{ total }} €</strong></div>
      <input type="hidden" name="montant" value="{{ total }}">
      <button type="submit" name="update" class="btn btn-secondary">Mettre à jour</button>
     {% if session.login is defined %}
  <button type="submit" name="placerCommande" class="btn btn-primary">Passer commande</button>
{% else %}
  <div class="alert alert-warning mt-3">Vous devez être connecté pour valider votre commande.</div>
{% endif %}

    </form>

  {% else %}
    <p>Votre panier est vide.</p>

    {% if form.commandeOK is defined and form.commandeOK %}
      <a href="index.php?page=facture&id={{ form.idCommande }}" class="btn btn-sm btn-outline-primary" target="_blank">
        📄 Télécharger la facture  (un mail contenant la facture vous à été envoyé automatiquement)
      </a>
    {% endif %}

    <a href="index.php?page=accueil" class="btn btn-outline-primary">Retour à l’accueil</a>
  {% endif %}
</div>
{% endblock %}
