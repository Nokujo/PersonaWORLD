<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">

  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="css/bootstrap.min.css">

  <link rel="stylesheet" href="css/style.css?v={{ "now"|date("U") }}">
  <link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      letter-spacing: 1px;
      margin-top: 120px;
    }
  </style>

  <title>{% block title %} PERSONA WORLD - {% endblock %}</title>
  {% block styles %}{% endblock %}

</head>

<body>


<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-dark fixed-top" style="background: var(--nav-bg); backdrop-filter: blur(12px); box-shadow: var(--shadow);">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center" href="index.php?page=accueil">
      <img src="./img/logo.webp" alt="Logo" class="logo mr-2" style="width: 40px; height: 40px; border-radius: 50%;">
      Persona WORLD
    </a>

    {% if session.role is not defined or session.role != 1 %}
      <a href="index.php?page=panier" class="btn btn-outline-light ml-auto d-lg-none">
        <i class="fas fa-shopping-cart"></i>
        <span class="cart-count">
          {% if session.panier is defined %}
            {{ session.panier|length }}
          {% else %}
            0
          {% endif %}
        </span>
        Panier
      </a>
    {% endif %}

    <button class="navbar-toggler ml-2" type="button" data-toggle="collapse" data-target="#navbarPW" aria-controls="navbarPW" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse justify-content-end" id="navbarPW">
      <ul class="navbar-nav align-items-center">
        <li class="nav-item"><a class="nav-link" href="index.php?page=accueil">Accueil</a></li>
        <li class="nav-item"><a class="nav-link" href="index.php?page=accueil#products">Boutique</a></li>
        <li class="nav-item"><a class="nav-link" href="index.php?page=contact">Contact</a></li>

        {% if session.login is defined %}
          <li class="nav-item"><a class="nav-link" href="#"> {{ session.login }}</a></li>
          <li class="nav-item"><a class="nav-link" href="index.php?page=deconnexion">Se déconnecter</a></li>

          {% if session.role == 1 %}
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="adminMenu" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                Administration
              </a>
              <div class="dropdown-menu dropdown-menu-right" aria-labelledby="adminMenu">
                <a class="dropdown-item" href="index.php?page=produit">Produit</a>
                <a class="dropdown-item" href="index.php?page=produitAjout">Ajouter produit</a>
                <a class="dropdown-item" href="index.php?page=type">Type</a>
                <a class="dropdown-item" href="index.php?page=utilisateur">Utilisateur</a>
                <a class="dropdown-item" href="index.php?page=commande">Commandes</a>
              </div>
            </li>
          {% endif %}
        {% else %}
          <li class="nav-item"><a class="nav-link" href="index.php?page=connexion">Connexion</a></li>
          <li class="nav-item"><a class="nav-link" href="index.php?page=inscrire">Inscription</a></li>
        {% endif %}

        {% if session.role is not defined or session.role != 1 %}
          <li class="nav-item d-none d-lg-block">
            <a href="index.php?page=panier" class="nav-link position-relative">
              <i class="fas fa-shopping-cart"></i>
              <span class="cart-count">
                {% if session.panier is defined %}
                  {{ session.panier|length }}
                {% else %}
                  0
                {% endif %}
              </span>
              Panier
            </a>
          </li>
        {% endif %}
      </ul>
    </div>
  </div>
</nav>



<!-- CONTENU DYNAMIQUE -->
{% block contenu %}
{% endblock %}

<!-- JS -->
<script src="script.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.1/dist/js/bootstrap.min.js"></script>
<script src="https://code.jquery.com/jquery-3.4.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>

</body>
</html>
