<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">

  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
  <link rel="stylesheet" href="css/style.css?v={{ "now"|date("U") }}">
  <link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      letter-spacing: 1px;
      margin-top: 120px;
    }
  </style>

  <title>{% block title %} PERSONA WORLD - {% endblock %}</title>
</head>

<body class="{{ bodyClass|default('') }}">

<!-- NAVBAR -->
<nav class="navbar">
  <div class="nav-container">
    <div class="nav-left">
      <div class="nav-logo">
        <img src="./img/logo.webp" alt="Logo" class="logo">
        <span>Persona WORLD</span>
      </div>
    </div>
    <div class="nav-right">
      <div class="nav-links">
        <a href="index.php?page=accueil" class="active">Accueil</a>
        <a href="#products">Boutique</a>

        {% if session.login is defined %}
          <a href="#"> {{ session.login }}</a>
          <a href="index.php?page=deconnexion">Se déconnecter</a>

          {% if session.role == 1 %}
          <div class="dropdown">
            <a class="btn btn-outline-warning dropdown-toggle" href="#" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              Administration
            </a>
            <div class="dropdown-menu">
              <a class="dropdown-item" href="index.php?page=produit">Produit</a>
              <a class="dropdown-item" href="index.php?page=produitAjout">Ajouter produit</a>
              <a class="dropdown-item" href="index.php?page=type">Type</a>
              <a class="dropdown-item" href="index.php?page=utilisateur">Utilisateur</a>
              <a class="dropdown-item" href="index.php?page=commande">Commandes</a>
            </div>
          </div>
          {% endif %}

        {% else %}
          <a href="index.php?page=connexion">Connexion</a>
          <a href="index.php?page=inscrire">Inscription</a>
        {% endif %}

        <button class="theme-toggle" id="themeToggle">
          <i class="fas fa-moon"></i>
        </button>

        {% if session.role is not defined or session.role != 1 %}
        <div class="cart-icon">
          <a href="index.php?page=panier" class="text-reset text-decoration-none">
            <i class="fas fa-shopping-cart"></i>
            <span class="cart-count">
              {% if session.panier is defined %}
                {{ session.panier|length }}
              {% else %}
                0
              {% endif %}
            </span>
            Panier
          </a>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</nav>

<!-- CONTENU DYNAMIQUE -->
{% block contenu %}
{% endblock %}

<!-- JS -->
<script src="script.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.1/dist/js/bootstrap.min.js"></script>
<script src="https://code.jquery.com/jquery-3.4.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>

</body>
</html>
