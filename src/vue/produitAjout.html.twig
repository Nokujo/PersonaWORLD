{% extends "base.html.twig" %}
{% block title %}{{ parent() }} Ajouter un produit{% endblock %}
{% block contenu %}
<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Ajouter un produit</h1>
    <a href="index.php?page=produit" class="btn btn-outline-light">
      ← Revenir à la liste
    </a>
  </div>

  {% if form.message is defined %}
    <div class="alert alert-info">
      {{ form.message }}
    </div>
  {% endif %}

  <form method="post" action="index.php?page=produitAjout">
    <div class="form-group">
      <label>Catégorie</label>
      <select name="type" class="form-control" required>
        <option value="">-- Choisir --</option>
        {% for t in form.types %}
          <option value="{{ t.id }}">{{ t.libelle }}</option>
        {% endfor %}
      </select>
    </div>

    <div class="form-group">
      <label>Nom</label>
      <input type="text" name="nom" class="form-control" required>
    </div>

    <div class="form-group">
      <label>Description</label>
      <textarea name="description" class="form-control" required></textarea>
    </div>

    <div class="form-group">
      <label>URL de l’image du produit</label>
      <input type="url" name="img" class="form-control" placeholder="https://exemple.com/image.jpg" required>
      <small class="form-text text-muted">Colle ici un lien direct vers ton image (format JPG, PNG, etc.).</small>
    </div>

    <div class="form-group">
      <label>Prix (€)</label>
      <input type="number" step="0.01" name="prix" class="form-control" required>
    </div>

    <div class="form-group">
      <label>Quantité</label>
      <input type="number" name="quantite" class="form-control" required>
    </div>

    <button type="submit" name="btAjouter" class="btn btn-success">Ajouter</button>
  </form>
</div>
{% endblock %}
