{% extends "base.html.twig" %}
{% block title %} {{ parent() }} Validation {% endblock %}
{% block contenu %}
<div class="container mt-5 text-center">
    {% if form.valide %}
    <div class="alert alert-success shadow p-4">
        <h1 class="display-4">Compte activé</h1>
        <p class="lead">{{ form.message }}</p>
        <p class="text-muted">L’utilisateur peut désormais se connecter à Persona World.</p>
        <a href="index.php?page=accueil" class="btn btn-outline-light mt-3">← Retour à l’accueil</a>
    </div>
{% else %}
    <div class="alert alert-danger shadow p-4">
        <h1 class="display-4">Échec de la validation</h1>
        <p class="lead">{{ form.message }}</p>
    </div>
{% endif %}

</div>
{% endblock %}
