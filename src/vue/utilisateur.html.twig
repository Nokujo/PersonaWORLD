{% extends "base.html.twig" %}

{% block title %} {{ parent() }}Liste des utilisateurs{% endblock %}

{% block contenu %}
<div class="container mt-5">
  <h2 class="text-center mb-4">Liste des utilisateurs</h2>

  {% if form.etat is defined %}
    <div class="alert alert-{{ form.etat ? 'success' : 'danger' }}">
      {{ form.etat ? 'Suppression réussie' : "Échec de la suppression" }}
    </div>
  {% endif %}

  <button id="toggleSelect" class="btn btn-secondary mb-4">
    Sélectionner plusieurs
  </button>

  <div class="table-responsive">
    <form id="userForm" action="index.php?page=utilisateur" method="post">
      <table class="table table-dark table-bordered table-hover">
        <thead>
          <tr>
            <th class="select-col text-center d-none">
              <input type="checkbox" id="selectAll">
            </th>
            <th>Email</th>
            <th>Pseudo</th>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Rôle</th>
            <th>Modifier</th>
            <th>Supprimer</th>
          </tr>
        </thead>
        <tbody>
          {% for u in liste %}
            <tr>
              <td class="select-col text-center d-none">
                <input type="checkbox" name="cocher[]" value="{{ u.id }}">
              </td>
              <td>{{ u.email }}</td>
              <td>{{ u.nuser }}</td>
              <td>{{ u.nom }}</td>
              <td>{{ u.prenom }}</td>
              <td>{{ u.libellerole }}</td>
              <td>
                <a href="index.php?page=utilisateurModif&id={{ u.id }}" class="btn btn-sm btn-outline-primary">Modifier</a>
              </td>
              <td>
                <a href="index.php?page=utilisateur&id={{ u.id }}"
                   onclick="return confirm('Supprimer cet utilisateur ?');"
                   class="btn btn-sm btn-outline-danger">
                  Supprimer
                </a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <button type="submit" name="btSupprimer" id="bulkDelete" class="btn btn-danger mt-3 d-none">
        Supprimer la sélection
      </button>
    </form>
  </div>
</div>

<script>
  const toggleBtn    = document.getElementById('toggleSelect');
  const checkCols    = document.querySelectorAll('.select-col');
  const selectAllCb  = document.getElementById('selectAll');
  const bulkDelete   = document.getElementById('bulkDelete');
  let selectionMode = false;

  toggleBtn.addEventListener('click', () => {
    selectionMode = !selectionMode;
    checkCols.forEach(td => td.classList.toggle('d-none', !selectionMode));
    bulkDelete.classList.toggle('d-none', !selectionMode);
    if (!selectionMode) {
      selectAllCb.checked = false;
      document.querySelectorAll('input[name="cocher[]"]').forEach(cb => cb.checked = false);
      toggleBtn.textContent = 'Sélectionner plusieurs';
    } else {
      toggleBtn.textContent = 'Annuler';
    }
  });

  selectAllCb.addEventListener('change', e => {
    document.querySelectorAll('input[name="cocher[]"]').forEach(cb => {
      cb.checked = e.target.checked;
    });
  });
</script>
{% endblock %}
